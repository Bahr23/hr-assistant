COMPOSE_PROJECT_NAME=hr-assistant

POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=hr_assistant
POSTGRES_USER=hr_assistant
POSTGRES_PASSWORD=hr_assistant
POSTGRES_PORT=5450
POSTGRES_HEALTHCHECK_INTERVAL=2s
POSTGRES_HEALTHCHECK_TIMEOUT=3s
POSTGRES_HEALTHCHECK_RETRIES=20

RABBITMQ_IMAGE=rabbitmq:4.1.8-management-alpine
RABBITMQ_USER=hr_assistant
RABBITMQ_PASSWORD=hr_assistant
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://hr_assistant:hr_assistant@rabbitmq:5672/
RABBITMQ_SHARDS=8
RABBITMQ_HEALTHCHECK_INTERVAL=5s
RABBITMQ_HEALTHCHECK_TIMEOUT=5s
RABBITMQ_HEALTHCHECK_RETRIES=20

APP_ENV=development
HTTP_ADDRESS=:8080
BACKEND_PORT=8080
DATABASE_URL=postgres://hr_assistant:hr_assistant@postgres:5432/hr_assistant?sslmode=disable
DATABASE_EXTERNAL_URL=postgres://hr_assistant:hr_assistant@localhost:5450/hr_assistant?sslmode=disable
MIGRATIONS_DIR=migrations
JWT_SECRET=replace-with-at-least-32-random-characters
TELEGRAM_BOT_URL=https://t.me/bot
BOT_TOKEN=replace-with-botfather-token
MASTER_API_TOKEN=replace-with-at-least-32-random-characters
BACKEND_API_URL=http://backend:8080/api/v1
BACKEND_TIMEOUT_SECONDS=5
TELEGRAM_SHARD_MESSAGES_PER_SECOND=2
TELEGRAM_CHAT_MESSAGES_PER_SECOND=1
TELEGRAM_SEND_MAX_RETRIES=8
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_NODE_IMAGE=node:24-alpine
FRONTEND_PORT=5173
FRONTEND_API_URL=http://localhost:8080/api/v1
FRONTEND_HEALTHCHECK_INTERVAL=5s
FRONTEND_HEALTHCHECK_TIMEOUT=3s
FRONTEND_HEALTHCHECK_RETRIES=10
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
HEALTHCHECK_URL=http://127.0.0.1:8080/health/ready
HEALTHCHECK_TIMEOUT=2s
BACKEND_HEALTHCHECK_INTERVAL=5s
BACKEND_HEALTHCHECK_TIMEOUT=3s
BACKEND_HEALTHCHECK_RETRIES=10
CLEANUP_INTERVAL=1h
CLEANUP_BATCH_SIZE=1000
CLEANUP_INBOX_RETENTION=720h
CLEANUP_OUTBOX_RETENTION=168h
CLEANUP_TELEGRAM_DELIVERY_RETENTION=2160h

# Rotate any key that has been posted in chat. Store only the replacement here.
OPENROUTER_API_KEY=replace-with-rotated-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TELEGRAM_API_BASE_URL=https://api.telegram.org
OPENROUTER_WORKER_HTTP_ADDRESS=:8081
OPENROUTER_WORKER_HEALTHCHECK_URL=http://127.0.0.1:8081/health/ready
OPENROUTER_WORKER_CONCURRENCY=4
OPENROUTER_HTTP_TIMEOUT=5m
OPENROUTER_JOB_LEASE=10m
OPENROUTER_MAX_BACKOFF=30m
OPENROUTER_TEMP_DIR=/tmp/openrouter-worker
OPENROUTER_CLEANUP_INTERVAL=1h
OPENROUTER_INBOX_RETENTION=720h
OPENROUTER_OUTBOX_RETENTION=168h
OPENROUTER_JOB_RETENTION=2160h

# Structured per-answer checks; separate from the audio transcription model.
OPENROUTER_EVALUATION_MODEL=openai/gpt-4.1-mini
# Модель общего отчёта по кандидату (Structured Outputs).
OPENROUTER_REPORT_MODEL=openai/gpt-5.6-terra
